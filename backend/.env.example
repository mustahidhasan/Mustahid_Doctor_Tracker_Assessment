# Local development template. Copy to backend/.env (git-ignored) and fill in real values.
# Production values are configured in the backend Vercel project, never in files.
NODE_ENV=development
PORT=5000
# Use a development database locally, e.g. .../doctor_tracker_dev
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=YOUR_SECURE_JWT_SECRET
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
# Used only by `npm run seed --prefix backend` to create the first admin (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD

# Development sample data (`npm run seed:data`). Never enable in production.
ALLOW_DEV_SEED=false
# Optional: pin generated dates for reproducible output (YYYY-MM-DD)
# SEED_REFERENCE_DATE=2026-11-11
