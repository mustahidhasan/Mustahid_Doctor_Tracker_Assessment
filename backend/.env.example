NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/doctor_tracker_dev
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-password-at-least-12-characters

# Development seed data (npm run seed:data). Never enable in production.
ALLOW_DEV_SEED=false
# Optional: pin generated dates for reproducible output (YYYY-MM-DD)
# SEED_REFERENCE_DATE=2026-11-11
